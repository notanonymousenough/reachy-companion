# Copy to paths.local.env only on Hub, mode0600. References, never secret values.
# Resolve exact pre-existing private companion/gateway authentication files there.
OBSERVER_CONFIG=/home/deploy/reachy-shadow/observer-service/observer.local.json
OBSERVER_COMPANION_CONFIG=/REQUIRES_EXISTING_HUB_COMPANION_CONFIG
OBSERVER_TOKEN_FILE=/REQUIRES_EXISTING_HUB_GATEWAY_TOKEN_FILE
# Exact blocker: no verified permanent Hub->PC auth/pin paths in R6 evidence.
# Do not copy Mac credentials or invent keys to make these placeholders pass.
OBSERVER_PC_SSH_CONFIG=/REQUIRES_EXISTING_HUB_PC_SSH_CONFIG
OBSERVER_PC_KNOWN_HOSTS=/REQUIRES_EXISTING_HUB_PC_KNOWN_HOSTS
OBSERVER_PC_IDENTITY_FILE=/REQUIRES_EXISTING_HUB_PC_IDENTITY_FILE
OBSERVER_PC_SSH_ALIAS=REQUIRES_VERIFIED_PC_ALIAS
