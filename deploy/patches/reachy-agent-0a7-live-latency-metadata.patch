+                        'final_write_begin', 'final_write_end')))
+
+    def _live_latency_mark(self, probe, name, at=None, replace=False):
+        if probe is None or probe['closed']:
+            return
+        now = time.monotonic() if at is None else at
+        if now >= probe['deadline']:
+            probe['expired'] = True
+            return
+        if replace or probe['marks'][name] is None:
+            probe['marks'][name] = round(max(0, now - probe['started']), 6)
+
+    def _live_latency_emit(self, probe, outcome, error_class=None):
+        if probe is None or probe['closed']:
+            return
+        probe['closed'] = True
+        expired = probe['expired'] or time.monotonic() >= probe['deadline']
+        record = {key: probe[key] for key in ('attempt_id', 'microphone_epoch', 'policy_epoch', 'marks',
+            'written_bytes', 'ack_submitted_bytes', 'final_submitted_bytes',
+            'final_received_offset_bytes', 'first_final_write_offset_bytes')}
+        record.update(version=1, agent_boot_id=self.agent_boot_id, outcome='expired' if expired else outcome,
+            error_class=error_class, written_frames=probe['written_bytes'] // 2,
+            speech_end_basis='vad_chunk_received', consumption_verified=False, acoustic_e2e_verified=False)
+        LOG.info('live_latency_metadata %s', json.dumps(record, separators=(',', ':'), allow_nan=False))
+
