+    def _live_latency_begin(self, epoch):
+        if not self._live_latency_remaining:
+            return None
+        now = time.monotonic()
+        if self._live_latency_deadline is None:
+            self._live_latency_deadline = now + 60
+        if now >= self._live_latency_deadline:
+            return None
+        self._live_latency_remaining -= 1
+        return dict(attempt_id=uuid4().hex, started=now, deadline=self._live_latency_deadline,
+                    microphone_epoch=epoch, policy_epoch=self.motion_policy.snapshot()['epoch'],
+                    closed=False, expired=False, audio_kind=None, written_bytes=0,
+                    ack_submitted_bytes=0, final_submitted_bytes=0,
