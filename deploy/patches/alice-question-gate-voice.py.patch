+class AliceQuestionRejected(RuntimeError):
+    """A complete model candidate failed the opt-in spoken-question policy."""
+
+
+def explicit_details(text):
+    value = unicodedata.normalize('NFKC', text).casefold().replace('ё', 'е').strip()
+    value = re.sub(r'^(?:ричи|reachy|алиса)\s*[,!]\s*', '', value)
+    value = re.sub(r'^пожалуйста[,\s]+', '', value)
+    detail = r'(?:подробнее|подробно|развернуто|детальнее|детально)'
+    if re.fullmatch(r'(?:можно\s+|давай\s+)?'+detail+r'[.!?]?', value):
+        return True
+    return bool(not re.search(r'\b(?:не|без|кратко|коротко)\b', value)
+        and re.search(r'\b'+detail+r'\b', value)
+        and re.match(r'^(?:(?:расскажи|объясни|раскрой|опиши|поясни|ответь|разверни)\b|'
+            r'(?:можешь\s+)?(?:рассказать|объяснить|раскрыть|описать|пояснить)\b|'
+            +detail+r'\s+(?:расскажи|объясни|опиши|поясни)\b)', value))
+
+
+def validate_alice_question(reply):
+    if type(reply) is not str:
+        raise TypeError('Model candidate must be text')
+    from .expressions import spoken_expression
+    from .spoken_reply import validate_text
+    body, _ = spoken_expression(reply)
+    try:
+        validate_text(body, dict(schema_version='reply-1', max_chars=120, no_question=False, no_wake=True))
+    except RuntimeError:
+        raise AliceQuestionRejected('Invalid short-question text') from None
+    if (not re.fullmatch(r'[^.!?…;:\n\r]+\?', body)
+            or not 3 <= len(re.findall(r'[^\W_]+', body)) <= 5
+            or not re.match(r'(?i)^(?:почему|как|что|откуда|зачем|когда|где|чем|какой|какая|какое|какие|кто|насколько)\b', body)):
+        raise AliceQuestionRejected('One complete 3-5 word question required')
+    return body  # Validation only: never select, repair, trim or substitute text.
 
 
