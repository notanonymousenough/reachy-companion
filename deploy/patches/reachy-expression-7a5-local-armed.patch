     def wait_timeline(self, clock):
         if not self.settings.get('enabled', False) or not self.permitted(): return
+        if self.timeline_gate == 'local_armed':
+            return self._wait_timeline_armed(clock)
         with self.condition:
             version = self.version
             deadline = time.monotonic()+self.config['timeouts']['http']+self.settings['max_total_seconds']+2
             while self.clock is clock and self.completed < version and not self.stopping.is_set():
                 if time.monotonic() >= deadline: raise TimeoutError('First speech motion did not start')
+                self.condition.wait(.05)
+
+    def _timeline_binding(self):
+        # Never call while holding condition: Agent withdrawal holds its mic
+        # lock while calling hold(), and capture_binding acquires that mic lock.
+        value = self.capture_binding()
+        fields = {'agent_boot_id', 'microphone_epoch', 'microphone_enabled', 'policy_epoch'}
+        if (type(value) is not dict or set(value) != fields
+                or type(value['agent_boot_id']) is not str or not 1 <= len(value['agent_boot_id']) <= 256
+                or type(value['microphone_enabled']) is not bool
+                or any(type(value[key]) is not int or not 0 <= value[key] < 2**63
+                       for key in ('microphone_epoch', 'policy_epoch'))):
+            raise RuntimeError('Current typed timeline binding required')
+        return dict(value)
+
+    def _timeline_current(self, ticket):
+        # Pure local checks, called under condition; this is not SDK admission.
+        return (self.state == ('timeline', 'neutral') and self.clock is ticket[0]
+                and self.version == ticket[1] and self.state_binding == ticket[2])
+
+    def _timeline_ready(self, ticket):
+        armed = self.timeline_armed
+        return (armed is not None and armed[0] is ticket[0] and armed[1] == ticket[1]
+                and armed[2] == ticket[2])
+
+    def _wait_timeline_armed(self, clock):
+        with self.condition:
+            ticket = (clock, self.version, dict(self.state_binding or {}))
+        deadline = time.monotonic()+self.config['timeouts']['http']+self.settings['max_total_seconds']+2
+        while True:
+            current = self._timeline_binding()
+            allowed = self.permitted()
+            with self.condition:
+                if (self.stopping.is_set() or not allowed or not self._timeline_current(ticket)
+                        or current != ticket[2]):
+                    raise RuntimeError('Timeline arming authority changed')
+                if time.monotonic() >= deadline:
+                    raise TimeoutError('Local speech timeline did not arm')
+                if self._timeline_ready(ticket):
+                    return
                 self.condition.wait(.05)
 
