+class AlicePhraseRejected(RuntimeError):
+    """No TTS dispatch: the explicit Alice reply was not one short sentence."""
+
+
+def validate_alice_phrase(text):
+    """Validate the whole phrase; never truncate, select a later fact or retry."""
+    if type(text) is not str:
+        raise AlicePhraseRejected('Alice reply must be text')
+    # Only a single existing address may be normalized to the canonical prefix.
+    body = re.sub(r'^алиса,\s+', '', text, count=1, flags=re.I)
+    spoken = 'Алиса, ' + body
+    if (body != body.strip() or len(spoken) > 120
+            or re.search(r'[\x00-\x1f<>*#`\[\]{}|]', body)
+            or not re.fullmatch(r'[^.!?…？؟！。．]+[.!?]', body)
+            or not 1 <= len(re.findall(r'[^\W_]+', body)) <= 10):
+        raise AlicePhraseRejected('One complete Alice phrase of at most 11 words required')
+    # Reject duplicate/malformed addresses and wake names inside the body.
+    normalized = ''.join(c for c in unicodedata.normalize('NFKD', body.casefold())
+                         if not unicodedata.combining(c))
+    mixed = normalized.translate(str.maketrans({'a':'а','l':'л','i':'и','s':'с','c':'с','e':'е'}))
+    if re.search('alice|alisa|алис', normalized) or 'алис' in mixed:
+        raise AlicePhraseRejected('Exactly one leading Alice address required')
+    return body
 
 
