            {
              "id": "attempt_id",
              "name": "attempt_id",
              "value": "={{ $json.body.attempt_id }}",
              "type": "string"
            },
            {
              "id": "value",
              "name": "value",
              "value": "={{ $json.body.value }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Echo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
