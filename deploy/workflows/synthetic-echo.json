      "position": [
        0,
        0
      ],
      "webhookId": "companion-synthetic-echo",
      "parameters": {
        "httpMethod": "POST",
        "path": "companion-synthetic-echo",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "reachyWebhookAuth",
          "name": "Reachy webhook auth"
        }
      }
    },
    {
      "id": "echo",
      "name": "Echo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
