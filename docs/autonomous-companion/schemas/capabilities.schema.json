{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reachy-companion:design:capabilities:1.1",
  "$defs": {
    "reason.background": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 16
        }
      },
      "required": [
        "question",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "web.search": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "query",
        "max_results"
      ],
      "additionalProperties": false
    },
    "speech.commit": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "proposal_id"
      ],
      "additionalProperties": false
    },
    "shell.sandbox": {
      "type": "object",
      "properties": {
        "template_id": {
          "enum": [
            "sandbox.list_workspace",
            "sandbox.read_text",
            "sandbox.resource_status"
          ]
        },
        "arguments": {
          "type": "object",
          "properties": {
            "relative_path": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(?!/)(?!.*\\.\\.)(?!.*[\\x00-\\x1f]).{1,128}$"
            }
          },
          "required": [
            "relative_path"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "template_id",
        "arguments"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "capability_id": {
          "const": "reason.background"
        },
        "arguments": {
          "$ref": "#/$defs/reason.background"
        }
      },
      "required": [
        "capability_id",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "capability_id": {
          "const": "web.search"
        },
        "arguments": {
          "$ref": "#/$defs/web.search"
        }
      },
      "required": [
        "capability_id",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "capability_id": {
          "const": "speech.commit"
        },
        "arguments": {
          "$ref": "#/$defs/speech.commit"
        }
      },
      "required": [
        "capability_id",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "capability_id": {
          "const": "shell.sandbox"
        },
        "arguments": {
          "$ref": "#/$defs/shell.sandbox"
        }
      },
      "required": [
        "capability_id",
        "arguments"
      ],
      "additionalProperties": false
    }
  ]
}
